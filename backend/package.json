{
  "name": "stock-lan-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && bun build src/server.ts --outdir dist --target bun --minify --sourcemap=linked --external @prisma/client --external argon2",
    "start:dist": "bun dist/server.js",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:coverage": "bun test --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "bun src/scripts/seed-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.8.1",
    "@prisma/client": "^6.19.3",
    "@scalar/fastify-api-reference": "^1.64.0",
    "argon2": "^0.44.0",
    "fastify": "^5.11.2",
    "fastify-type-provider-zod": "^6.1.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "redis": "^5.12.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.19.3",
    "typescript": "^7.0.2"
  }
}
